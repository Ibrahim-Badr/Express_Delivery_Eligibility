ENVIRONMENT=local
ARTIFACTS_DIR=artifacts
MODEL_PATH=artifacts/express_delivery_model.joblib
MODEL_THRESHOLD=0.5
MODEL_VERSION=1.0.0
RANDOM_SEED=42
LOG_LEVEL=INFO

# Retraining orchestrator parameters
RETRAIN_INTERVAL_SECONDS=30.0
RETRAIN_MIN_NEW_ORDERS=50

# Tracking URI for MLflow experiment logs
MLFLOW_TRACKING_URI=sqlite:///./local_databases/mlflow.db

# Database Connection:
# 1. PostgreSQL ERP database (Default for Docker and TP4 integration):
# DATABASE_URL=postgresql://livraison:livraison@localhost:5432/livraison_express
# 2. Local SQLite fallback (For fast local testing without Docker):
DATABASE_URL=sqlite:///./local_databases/local.db
